# ---- 基础 ----
DATABASE_URL="file:../data/app.db"
# 随便填一串长随机字符串，用于签名登录 cookie
SESSION_SECRET="change-me-to-a-long-random-string"
# 数据目录：图片、视频、学生项目都存在这里
DATA_DIR="./data"

# ---- 生图（画布） ----
# openai | mock（mock 返回占位图，不消耗任何额度）
IMAGE_PROVIDER="mock"
OPENAI_API_KEY=""
# 图像模型名（文生图）：gpt-image-2.5-flare 更快；可选 gpt-image-2.5-sunburst、gpt-image-2、gpt-image-1.5
OPENAI_IMAGE_MODEL="gpt-image-2.5-flare"
# 图生图（有参考图）用的模型：sunburst 更擅长编辑和多图融合；留空则同上
OPENAI_IMAGE_EDIT_MODEL="gpt-image-2.5-sunburst"
# 画质：low（最快最省）| medium | high
OPENAI_IMAGE_QUALITY="medium"
# 可选：OpenAI 兼容的中转地址（国内网络常用），留空用官方地址
OPENAI_BASE_URL=""

# ---- 生视频（本期暂缓） ----
VIDEO_PROVIDER="mock"

# ---- Vibe Coding ----
# claude | mock（mock 模拟流式过程，用于不带 key 的界面调试）
CODING_PROVIDER="mock"
# 必须是 Claude Console 的 API key（产品形态不能用 Pro/Max 订阅）
ANTHROPIC_API_KEY=""
CODING_MODEL="claude-sonnet-5-5"
